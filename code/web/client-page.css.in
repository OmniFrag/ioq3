/* The web client page's style (client.html.in), a file of its own so the
 * page's content security policy needs no 'unsafe-inline'. Configured with
 * the page (@ONLY). */
html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: rgb(0, 0, 0); }
/* Fill the page. SDL3 resizes the canvas to its CSS size as the page
   changes, and the engine follows without a restart. dvh follows mobile
   browsers' toolbars. SDL3 needs no border or padding on the canvas. */
canvas { display: block; width: 100vw; height: 100dvh; border: 0; padding: 0; }
canvas:focus { outline: none; }
/* the system's cursor, never over a match whose game wants the pointer
   (showPlay), over SDL's own canvas cursor */
canvas.held { cursor: none !important; }
/* The page's word over the game: the download's progress, or an error.
   Clicks go through it to the canvas, where SDL asks for the pointer. */
#status, #hints, #leaving { position: fixed; pointer-events: none; font: 18px/1.4 system-ui, sans-serif; color: rgb(235, 235, 235); text-align: center; }
#status { inset: 0; display: grid; place-items: center; }
#status[hidden] { display: none; }
#status > div, .hint, #leaving span { background: rgba(0, 0, 0, 0.7); border-radius: 8px; }
#status > div { padding: 16px 24px; max-width: min(32em, 80vw); }
#status progress { display: block; width: 100%; margin-top: 8px; }
#status progress[hidden] { display: none; }
/* an error stays, and its words can be copied */
#status.error { pointer-events: auto; user-select: text; }
/* The page's hints near the top center, where a browser says how to leave
   fullscreen: how to leave it and come back, and "Click to play"; #status
   is the download's and errors'. Clicks go through them. A hint fades in
   from nothing and, faded out and emptied, takes no room */
#hints { top: 48px; left: 16px; right: 16px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.hint { padding: 8px 16px; opacity: 0; transition: opacity 0.4s; }
.hint:empty { display: none; }
.hint.shown { opacity: 1; }
@starting-style { .hint.shown { opacity: 0; } }
/* The ring that fills while Esc is held to leave fullscreen, low in the
   center: it shows after --ring-after, so a tap never shows it, and is full
   after --ring-fill more (the page's script sets both) */
#leaving { left: 50%; bottom: 15%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; opacity: 0; transition: opacity 0.15s; }
#leaving.holding { opacity: 1; transition-delay: var(--ring-after); }
#leaving span { padding: 8px 16px; }
#leaving svg { width: 48px; height: 48px; transform: rotate(-90deg); }
#leaving circle { fill: none; }
#leaving .track { stroke: rgba(0, 0, 0, 0.7); stroke-width: 8; }
/* What the page asks before the game data downloads: an agreement to
   accept, or the player's own files to choose. It takes clicks and its
   words can be copied. */
#ask { position: fixed; inset: 0; display: grid; place-items: center; font: 16px/1.4 system-ui, sans-serif; color: rgb(235, 235, 235); }
#ask[hidden] { display: none; }
#ask > div { background: rgba(0, 0, 0, 0.85); border-radius: 8px; padding: 16px 24px; max-width: min(44em, 90vw); max-height: 90dvh; overflow: auto; user-select: text; }
#ask pre { white-space: pre-wrap; text-align: left; max-height: 55dvh; overflow: auto; font: 13px/1.4 ui-monospace, monospace; background: rgba(255, 255, 255, 0.06); padding: 8px; }
#ask button, #ask label { font: inherit; margin: 8px 8px 0 0; padding: 6px 16px; border-radius: 6px; border: 1px solid rgb(120, 120, 120); background: rgb(40, 40, 40); color: inherit; cursor: pointer; display: inline-block; }
#ask input[type=file] { display: none; }
/* What's left once the player quits: the page's own plain screen in place
   of the game's last frame, and a way to play again */
#left { position: fixed; inset: 0; display: grid; place-items: center; background: rgb(16, 16, 16); font: 18px/1.4 system-ui, sans-serif; color: rgb(235, 235, 235); text-align: center; }
#left[hidden] { display: none; }
#left p { margin: 0 0 16px; }
#left button { font: inherit; padding: 10px 24px; border-radius: 6px; border: 1px solid rgb(120, 120, 120); background: rgb(40, 40, 40); color: inherit; cursor: pointer; }
#leaving .fill { stroke: rgb(235, 235, 235); stroke-width: 4; stroke-dasharray: 1; stroke-dashoffset: 1; }
#leaving.holding .fill { animation: leaving-fill var(--ring-fill) linear var(--ring-after) forwards; }
@keyframes leaving-fill { to { stroke-dashoffset: 0; } }
/* The shared site's page: the server as its link reached it, what it calls
   itself, and whose it is, until the game draws */
#central { position: fixed; top: 0; left: 0; right: 0; padding: 10px 16px; font: 15px/1.4 system-ui, sans-serif; color: rgb(235, 235, 235); background: rgba(0, 0, 0, 0.7); overflow-wrap: anywhere; }
#central[hidden] { display: none; }
#central span { color: rgb(180, 180, 180); }
#central p { margin: 2px 0 0; font-size: 13px; color: rgb(180, 180, 180); }
