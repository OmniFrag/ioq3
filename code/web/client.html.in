<!DOCTYPE html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@WEB_PAGE_TITLE@</title>
@WEB_PAGE_SVG_ICON_LINK@<link rel=icon href="@CLIENT_NAME@.png">
<link rel=manifest href="@CLIENT_NAME@.webmanifest">
<style>
html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #000; }
canvas { display: block; width: 100vw; height: 100dvh; border: 0; padding: 0; }
canvas:focus { outline: none; }
</style>
<!-- Minimal standalone dev shell used only when WEB_SHELL_DIR is not set. -->
<canvas id=canvas tabindex=0></canvas>
<script type=module>
import ioquake3 from './@CLIENT_BINARY@.js';
const canvas = document.getElementById('canvas');
const BASEGAME = '@BASEGAME@';
const PRELOAD = '@EMSCRIPTEN_PRELOAD_FILE@' === 'ON';
const args = ['+set', 'com_basegame', `"${BASEGAME}"`];
const config = PRELOAD
  ? { [BASEGAME]: { files: [] } }
  : await fetch('./@CLIENT_NAME@-config.json').then((r) => r.json());
ioquake3({
  canvas,
  arguments: args,
  locateFile: (file) => './' + file,
  preRun: [async (module) => {
    module.addRunDependency('standalone-files');
    for (const file of (config[BASEGAME]?.files ?? [])) {
      const res = await fetch('./' + file.src);
      if (!res.ok) continue;
      module.FS.mkdirTree(file.dst);
      module.FS.writeFile(`${file.dst}/${file.src.split('/').pop()}`, new Uint8Array(await res.arrayBuffer()));
    }
    module.removeRunDependency('standalone-files');
  }],
});
</script>
